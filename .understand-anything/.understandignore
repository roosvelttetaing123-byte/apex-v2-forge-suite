*.so
*.egg-info/
.tox/
env/
*.db
*.sqlite3
engagements/
extracted_images/
*.pptx
*.docx
results/
evidence/
screenshots/
.env
.env.*
secrets.*
credentials.*
*.pem
*.key
.tls/
*.swp
*~
.mypy_cache/
.pytest_cache/
.agents/worktrees/
.claude/worktrees/

