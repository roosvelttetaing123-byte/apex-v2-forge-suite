# Forge Suite operator configuration reference.
#
# Keep real values outside version control. install.sh intentionally does not
# copy this file to .env. For Compose, export the canonical version first:
#   export FORGE_VERSION="$(tr -d '\r\n' < VERSION)"
FORGE_VERSION=

# Dashboard authentication has no shipped password. Prefer a verifier instead
# of plaintext. Generate one interactively, then export the printed value:
#   python3 -c 'from getpass import getpass; from common.dashboard.auth import _hash_password; print(_hash_password(getpass("Dashboard password: ")))'
FORGE_DASHBOARD_PASSWORD_HASH=
FORGE_DASHBOARD_USER=operator
FORGE_DASHBOARD_ROLE=admin
FORGE_DASHBOARD_BIND=127.0.0.1
FORGE_DASHBOARD_PUBLIC_HOST=localhost

# The public host must be covered by the certificate SAN. Before starting the
# dashboard, make both paths non-empty regular files owned by numeric UID/GID
# 10001; keep the private key owner-only (0400 or 0600). The dashboard runtime
# guard rejects blank inputs and the Linux /dev/null sentinel before Python
# starts. Isolated C2 and scan profiles do not require dashboard variables.
FORGE_DASHBOARD_TLS_CERT_FILE=
FORGE_DASHBOARD_TLS_KEY_FILE=

# Required only when explicitly starting the non-default local-lab-c2 profile:
#   docker compose --profile local-lab-c2 up forge-c2
FORGE_C2_ADMIN_PW=

# AI-assisted analysis is optional. Leave blank for local rule-based behavior.
ANTHROPIC_API_KEY=
FORGE_BRAIN_MODEL=
FORGE_BRAIN_FAST_MODEL=
FORGE_BRAIN_RPM=20
FORGE_BRAIN_MAX_MEMORY=100

# OOB callback service configuration (optional, operator-managed infrastructure).
FORGE_COLLAB_DOMAIN=
FORGE_COLLAB_HTTP_PORT=8888
FORGE_COLLAB_DNS_PORT=53
FORGE_COLLAB_SMTP_PORT=25
FORGE_COLLAB_API_PORT=8889

# Intelligence sources. Nuclei is deliberately not installed by Forge; when
# explicitly needed, provide a separately pinned and verified `nuclei` on PATH.
FORGE_NVD_API_KEY=
FORGE_GITHUB_TOKEN=
FORGE_INTEL_DB=

# Notification and external integrations (all optional).
FORGE_SLACK_WEBHOOK=
FORGE_TEAMS_WEBHOOK=
FORGE_SHODAN_KEY=
FORGE_JIRA_URL=
FORGE_JIRA_TOKEN=
FORGE_JIRA_PROJECT=
