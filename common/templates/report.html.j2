<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ framework | e }} Report — {{ engagement | e }}</title>
<style>
  body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; }
  h1   { color: #333; border-bottom: 3px solid #e74c3c; padding-bottom: 10px; }
  .meta {
    background: #fff; padding: 15px; border-radius: 6px;
    margin-bottom: 20px; border-left: 4px solid #e74c3c;
  }
  .summary { margin-bottom: 15px; }
  .badge {
    display: inline-block; padding: 6px 12px; margin: 4px;
    border-radius: 4px; font-weight: bold;
  }
  table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 6px; overflow: hidden; }
  th    { background: #2c3e50; color: #fff; padding: 10px; text-align: left; }
  td    { padding: 8px 10px; border-bottom: 1px solid #eee; vertical-align: top; }
  tr:hover td { background: #f0f0f0; }
  .detail { background: #f9f9f9; padding: 12px; }
  pre {
    margin: 0; white-space: pre-wrap; word-break: break-all;
    font-size: 12px; border-radius: 4px;
    background: #1e1e1e; color: #d4d4d4; padding: 8px; overflow: auto;
  }
  img  { border-radius: 4px; max-width: 800px; border: 2px solid red; }
  ol   { margin: 4px 0; padding-left: 20px; }
  .footer { color: #999; font-size: 11px; margin-top: 20px; }
</style>
</head>
<body>

<h1>{{ framework | upper | e }} — Penetration Test Report</h1>

<div class="meta">
  <strong>Engagement:</strong> {{ engagement | e }} &nbsp;|&nbsp;
  <strong>Target:</strong> {{ target | e }} &nbsp;|&nbsp;
  <strong>Tester:</strong> {{ tester | e }} &nbsp;|&nbsp;
  <strong>Generated:</strong> {{ generated_at }} &nbsp;|&nbsp;
  <strong>Total Findings:</strong> {{ findings | length }}
</div>

<div class="summary">
  {% for sev, count in summary.items() if count > 0 %}
  <span class="badge" style="background:{{ severity_colors[sev] }};color:{{ 'white' if sev in ('Critical','High') else 'black' }}">
    {{ sev }}: {{ count }}
  </span>
  {% endfor %}
</div>

<table>
  <thead>
    <tr>
      <th>#</th><th>Vulnerability</th><th>Severity</th><th>CVSS</th>
      <th>Target</th><th>Port</th><th>Module</th>
    </tr>
  </thead>
  <tbody>
  {% for f in findings %}
  {% set sev = f.severity | default('Informational') %}
  {% set color = severity_colors[sev] %}
  {% set tc = 'white' if sev in ('Critical', 'High') else 'black' %}
  <tr>
    <td>{{ loop.index }}</td>
    <td><strong>{{ f.title | e }}</strong></td>
    <td style="background:{{ color }};color:{{ tc }};text-align:center;font-weight:bold">
      {{ sev | e }}
    </td>
    <td>{{ f.cvss_v31_score | default('') }}</td>
    <td>{{ f.target | default('') | e }}</td>
    <td>{{ f.port | default('') }}</td>
    <td>{{ f.module | default('') | e }}</td>
  </tr>
  <tr>
    <td colspan="7" class="detail">
      <strong>Description:</strong> {{ f.description | e }}<br>
      <strong>Reproduction:</strong>
      <ol>
        {% for step in f.reproduction_steps | default([]) %}
        <li>{{ step | e }}</li>
        {% endfor %}
      </ol>
      <strong>Remediation:</strong> {{ f.remediation | default('') | e }}<br>
      <strong>References:</strong> {{ f.references | default([]) | join(', ') | e }}<br>
      {% if f.mitre_attack %}
      <strong>MITRE ATT&amp;CK:</strong> {{ f.mitre_attack | join(', ') | e }}<br>
      {% endif %}
      {% set ev = f.evidence | default({}) %}
      {% if ev.screenshot_b64 %}
      <br><strong>Screenshot (POC):</strong><br>
      <img src="{{ ev.screenshot_b64 }}" alt="POC screenshot">
      {% endif %}
      {% if ev.request_raw %}
      <br><strong>Request:</strong><pre>{{ ev.request_raw | e }}</pre>
      {% endif %}
      {% if ev.response_raw %}
      <br><strong>Response:</strong><pre>{{ ev.response_raw[:2000] | e }}</pre>
      {% endif %}
    </td>
  </tr>
  {% endfor %}
  </tbody>
</table>

<p class="footer">Generated by {{ framework | e }} — FOR AUTHORIZED USE ONLY</p>
</body>
</html>
